setcps(115/60/4)

let chords = chord("<Gm9 Ebmaj7 Bbmaj7 F6>/4").dict('ireal')

stack(
  //drums
  stack(
    s("bd ~ bd ~").gain(1.5),
    s("~ sd ~ sd").gain(1.35),
    s("hh*8")
  ),

  //chords
  chords
    .voicing()
    .s("gm_epiano1:1")
    .phaser(3)
    .room(.6)
    .gain(1.15),

  //bass
  n("0 ~ 0 2 3 ~ 3 2")
    .set(chords)
    .mode("root:g2")
    .voicing()
    .s("gm_acoustic_bass")
    .lpf(900)
    .gain(1.5),

  n("0 ~ 0 2 ~ 3 2 ~")
    .set(chords)
    .mode("root:g1")
    .voicing()
    .s("gm_acoustic_bass")
    .lpf(550)
    .gain(.8),

  //lead
  n(`
    <
      [0 ~ 2 ~ 4 ~ 2 ~]
      [1 ~ 3 ~ 2 ~ 4 ~]
      [2 ~ 4 ~ 1 ~ 3 ~]
      [4 ~ 2 ~ 3 ~ 1 ~]
    >*4
  `)
    .set(chords)
    .anchor("D5")
    .voicing()
    .s("gm_epiano1:2")
    .fm(sine.range(2,8).slow(8))
    .lpf(sine.range(700,2800).slow(8))
    .lpq(5)
    .room(.8)
    .delay(.3)
    .gain(.65)
)